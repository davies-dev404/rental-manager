# =====================================================================
# MakaziFlow Backend Environment Configuration Example
# Copy to server/.env and populate values cleanly. NEVER commit real secrets.
# =====================================================================

NODE_ENV=development
PORT=5000

# MongoDB Atlas / Local URI
MONGODB_URI=mongodb://127.0.0.1:27017/rental_manager_dev
JWT_SECRET=replace_with_at_least_32_random_characters

# Frontend Origin URLs
FRONTEND_URL=http://localhost:5173
PROD_FRONTEND_URL=https://makaziflow.afrinextech.co.ke

# Primary Payment Gateway: Pesapal API 3.0 (Sandbox / Production Switching)
# Switch without code changes by setting PESAPAL_ENV=production + production keys below
PAYMENT_DEFAULT_PROVIDER=pesapal
PESAPAL_ENV=sandbox

# Pesapal Sandbox Credentials (https://cybqa.pesapal.com/pesapalv3)
PESAPAL_SANDBOX_CONSUMER_KEY=your_pesapal_sandbox_consumer_key
PESAPAL_SANDBOX_CONSUMER_SECRET=your_pesapal_sandbox_consumer_secret
PESAPAL_SANDBOX_IPN_ID=

# Pesapal Production Credentials (https://pay.pesapal.com/v3)
PESAPAL_PRODUCTION_CONSUMER_KEY=
PESAPAL_PRODUCTION_CONSUMER_SECRET=
PESAPAL_PRODUCTION_IPN_ID=

# Pesapal Callback & IPN URLs
PESAPAL_CALLBACK_URL=https://makaziflow.afrinextech.co.ke/billing
PESAPAL_IPN_URL=https://rental-manager-1-7jmg.onrender.com/api/v2/payments/webhooks/pesapal

# Secondary Payment Gateway: IntaSend
INTASEND_ENV=sandbox
INTASEND_SANDBOX_PUBLISHABLE_KEY=your_intasend_sandbox_publishable_key
INTASEND_SANDBOX_SECRET_KEY=your_intasend_sandbox_secret_key
INTASEND_SANDBOX_WEBHOOK_CHALLENGE=your_webhook_challenge
INTASEND_PRODUCTION_PUBLISHABLE_KEY=
INTASEND_PRODUCTION_SECRET_KEY=
INTASEND_PRODUCTION_WEBHOOK_CHALLENGE=your_webhook_challenge
INTASEND_CALLBACK_URL=https://makaziflow.afrinextech.co.ke/billing
INTASEND_IPN_URL=https://rental-manager-1-7jmg.onrender.com/api/v2/payments/webhooks/intasend
