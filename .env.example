# ==============================================================================
# MakaziFlow SaaS Platform - Environment Variable Template
# Copy this file to .env and replace placeholder values with real credentials.
# NEVER commit actual .env secrets to version control.
# ==============================================================================

# --- Server & Database ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rental_manager?retryWrites=true&w=majority
MONGODB_DEV_URI=mongodb://127.0.0.1:27017/rental_manager_dev
JWT_SECRET=replace_with_strong_random_jwt_secret

# --- Business Contact Information ---
BUSINESS_NAME=MakaziFlow
BUSINESS_PHONE=0790264792
BUSINESS_EMAIL=info@afrinextech.co.ke
BUSINESS_ADDRESS=Busia, Kenya

# --- URLs & CORS ---
FRONTEND_URL=http://localhost:5173
PROD_FRONTEND_URL=https://makaziflow.afrinextech.co.ke
BACKEND_URL=http://localhost:5000

# --- Centralized Payment Gateway: Pesaflow (Primary) ---
# Obtain merchant credentials from Pesaflow onboarding (support@pesaflow.com)
PESAFLOW_ENVIRONMENT=sandbox
# Sandbox: https://test.pesaflow.com | Production: https://payments.ecitizen.go.ke (or merchant-assigned URL)
PESAFLOW_API_BASE_URL=https://test.pesaflow.com
PESAFLOW_CHECKOUT_URL=https://test.pesaflow.com/PaymentAPI/iframev2.1.php
PESAFLOW_STATUS_URL=https://test.pesaflow.com/api/invoice/payment/status
PESAFLOW_API_CLIENT_ID=your_pesaflow_api_client_id
PESAFLOW_API_KEY=your_pesaflow_api_key
PESAFLOW_API_SECRET=your_pesaflow_api_secret
PESAFLOW_SERVICE_ID=your_pesaflow_service_id
PESAFLOW_WEBHOOK_SECRET=your_pesaflow_webhook_secret
PESAFLOW_CALLBACK_URL=https://your-backend-domain.com/api/v2/payments/webhooks/pesaflow
PESAFLOW_SUCCESS_REDIRECT_URL=https://makaziflow.afrinextech.co.ke/billing?payment=success
PESAFLOW_FAIL_REDIRECT_URL=https://makaziflow.afrinextech.co.ke/billing?payment=failed
PESAFLOW_PAYBILL_NUMBER=

# --- Optional Bank Gateway Adapters (Require Official Merchant Authorization) ---
EQUITY_EAZZYBIZ_ENABLED=false
EQUITY_EAZZYBIZ_BASE_URL=
EQUITY_EAZZYBIZ_MERCHANT_CODE=
EQUITY_EAZZYBIZ_API_KEY=
EQUITY_EAZZYBIZ_API_SECRET=

KCB_BUNI_ENABLED=false
KCB_BUNI_BASE_URL=
KCB_BUNI_CLIENT_ID=
KCB_BUNI_CLIENT_SECRET=
KCB_BUNI_SHORTCODE=

COOP_BANK_ENABLED=false
COOP_BANK_BASE_URL=
COOP_BANK_CONSUMER_KEY=
COOP_BANK_CONSUMER_SECRET=
COOP_BANK_ACCOUNT_NO=

# --- KRA eTIMS OSCU / VSCU Integration ---
# Sandbox OSCU: https://etims-api-sbx.kra.go.ke/etims-api
# Production OSCU: https://etims-api.kra.go.ke/etims-api
ETIMS_ENVIRONMENT=sandbox
ETIMS_MODE=oscu
ETIMS_API_URL=https://etims-api-sbx.kra.go.ke/etims-api
ETIMS_API_KEY=your_kra_etims_api_key_if_applicable
ETIMS_TIN=P000000000Z
ETIMS_BHF_ID=00
ETIMS_DEVICE_SERIAL_NO=your_kra_device_serial_number
ETIMS_CMC_KEY=your_etims_cmc_key_from_selectInitOsdcInfo
ETIMS_DEFAULT_VAT_RATE=16

# --- Email, OTP, SMS & Campaigns (Brevo Only) ---
FROM_NAME=MakaziFlow
FROM_EMAIL=info@afrinextech.co.ke
BREVO_API_KEY=your_brevo_v3_api_key
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_login
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_SENDER_NAME=MakaziFlow
BREVO_SENDER_EMAIL=info@afrinextech.co.ke
BREVO_SMS_SENDER=MakaziFlow
BREVO_WHATSAPP_SENDER=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key

# --- Security, Super Admin & Google Reviews ---
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
SUPERADMIN_EMAILS=
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
GOOGLE_REVIEW_URL=
