# =====================================================================
# MakaziFlow Backend Environment Configuration Example
# Copy to server/.env and populate values cleanly. NEVER commit real secrets.
# =====================================================================

NODE_ENV=development
PORT=5000

# MongoDB Atlas / Local URI
MONGODB_URI=mongodb://127.0.0.1:27017/rental_manager_dev
JWT_SECRET=replace_with_at_least_32_random_characters

# Frontend Origin URLs
FRONTEND_URL=http://localhost:5173
PROD_FRONTEND_URL=https://makaziflow.afrinextech.co.ke

# Primary Payment Gateway: IntaSend (Unified v1 API: https://api.intasend.com/api/v1)
# Switch without code changes by setting INTASEND_ENV=production + live keys below
INTASEND_ENV=sandbox
PAYMENT_DEFAULT_PROVIDER=intasend

# IntaSend Sandbox Credentials (https://sandbox.intasend.com dashboard)
INTASEND_SANDBOX_PUBLISHABLE_KEY=ISPubKey_test_bdf09183-3235-4dbd-9d36-345dad5ec7ee
INTASEND_SANDBOX_SECRET_KEY=ISSecretKey_test_7598fdcd-5711-442c-875e-462c9aca62dc
INTASEND_SANDBOX_WEBHOOK_CHALLENGE=TangoAlpha@69

# IntaSend Production Credentials (https://payment.intasend.com dashboard)
INTASEND_PRODUCTION_PUBLISHABLE_KEY=
INTASEND_PRODUCTION_SECRET_KEY=
INTASEND_PRODUCTION_WEBHOOK_CHALLENGE=TangoAlpha@69

# Callback & Webhook URLs
INTASEND_CALLBACK_URL=https://makaziflow.afrinextech.co.ke/billing
INTASEND_IPN_URL=https://rental-manager-1-7jmg.onrender.com/api/v2/payments/webhooks/intasend
