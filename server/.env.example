# Server Environment Variables Template
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=Dwello

# KRA Integration (eTIMS)
KRA_CLIENT_ID=your_kra_client_id
KRA_CLIENT_SECRET=your_kra_client_secret
KRA_TOKEN_URL=https://sandbox-api.kra.go.ke/oauth/token
KRA_API_BASE=https://sandbox-api.kra.go.ke

# Social Auth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICE_ID=
